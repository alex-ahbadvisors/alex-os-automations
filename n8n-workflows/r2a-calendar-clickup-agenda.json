    {
      "parameters": {
        "jsCode": "// Parse the ClickUp list-task lookup response. Deterministic; no LLM.\n// The GET returns { tasks: [...] }. We treat the FIRST match on the gCal ID\n// custom field as the existing agenda task (idempotency + reschedule key).\n// Convergence-safe: guard the upstream $() ref in try/catch.\nlet ctx = {};\ntry { ctx = $('Extract + Classify').item.json || {}; } catch (e) { ctx = {}; }\n\nlet resp = {};\ntry { resp = $input.item.json || {}; } catch (e) { resp = {}; }\n\nlet tasks = [];\nif (Array.isArray(resp.tasks)) tasks = resp.tasks;\nelse if ((resp.body && Array.isArray(resp.body.tasks))) tasks = resp.body.tasks;\n\nconst found = tasks.length > 0;\nconst existingTaskId = found ? (tasks[0].id || '') : '';\n\nreturn {\n  json: Object.assign({}, ctx, {\n    found,\n    existingTaskId\n  })\n};"
      },
