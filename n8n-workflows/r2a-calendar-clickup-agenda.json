    {
      "parameters": {},
      "id": "5df360c7-ec98-4c74-bbd9-660dac6548e4",
      "name": "Skip Non-Meeting",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        368
      ]
    },
    {
      "parameters": {
        "jsCode": "// DETERMINISTIC extract + positive \"real meeting\" classifier. Zero LLM.\n// Runs after the keyword denylist (Is Real Meeting IF). It:\n//   1. Re-derives attendee emails + UNIQUE domains from the ACTUAL Google\n//      Calendar attendees array (fixes Relay's empty-domains bug: Relay mapped\n//      key \"email domains\" but read input.emails -> domains were always blank).\n//   2. Computes a POSITIVE real-meeting signal that the keyword denylist misses\n//      (solo doctor/flight/focus blocks): otherAttendeeCount + hasVideoLink.\n//   3. Emits the normalized fields + booleans for the downstream If.\n// Convergence-safe: the event arrives on $input; no cross-node $() needed here,\n// but we still guard every lookup.\nconst SELF_EMAIL = 'alex@ahbadvisors.com';\nlet ev = {};\ntry { ev = $input.item.json || {}; } catch (e) { ev = {}; }\n\nconst attendees = Array.isArray(ev.attendees) ? ev.attendees : [];\n\n// All guest emails (for the Attendee Emails field).\nconst allEmails = attendees\n  .map(a => (a && a.email ? String(a.email).trim() : ''))\n  .filter(Boolean);\n\n// \"Other\" attendees = real humans who are not Alex, not the calendar owner\n// (self), and not a resource (room/equipment).\nconst otherAttendees = attendees.filter(a => {\n  if (!a) return false;\n  if (a.self === true) return false;\n  if (a.resource === true) return false;\n  const em = a.email ? String(a.email).trim().toLowerCase() : '';\n  if (!em) return false;\n  if (em === SELF_EMAIL.toLowerCase()) return false;\n  return true;\n});\nconst otherAttendeeCount = otherAttendees.length;\n\n// Unique email domains (deterministic dedup) — the bug Relay never fixed.\nconst attendeeDomains = [...new Set(\n  allEmails\n    .map(e => (e.split('@')[1] || '').toLowerCase())\n    .filter(Boolean)\n)];\n\n// Video / conference link: hangoutLink, then conferenceData entry points,\n// then a URL sniffed from location/description.\nlet meetingLink = ev.hangoutLink || '';\nif (!meetingLink && ev.conferenceData && Array.isArray(ev.conferenceData.entryPoints)) {\n  const video = ev.conferenceData.entryPoints.find(p => p && p.entryPointType === 'video');\n  meetingLink = (video && video.uri) || (ev.conferenceData.entryPoints[0] && ev.conferenceData.entryPoints[0].uri) || '';\n}\nconst VIDEO_RE = /(zoom\\.us|meet\\.google\\.com|teams\\.microsoft\\.com|teams\\.live\\.com|webex\\.com|whereby\\.com|meet\\.jit\\.si|hangouts\\.google\\.com)/i;\nlet sniffedLink = '';\nconst blob = String((ev.location || '') + ' ' + (ev.description || ''));\nconst m = blob.match(/https?:\\/\\/\\S+/g);\nif (m) { const hit = m.find(u => VIDEO_RE.test(u)); if (hit) sniffedLink = hit.replace(/[)>\\].,]+$/, ''); }\nif (!meetingLink && sniffedLink) meetingLink = sniffedLink;\n\nconst hasVideoLink = Boolean(\n  ev.hangoutLink ||\n  (ev.conferenceData && ((ev.conferenceData.entryPoints && ev.conferenceData.entryPoints.length) || ev.conferenceData.conferenceId)) ||\n  meetingLink ||\n  VIDEO_RE.test(blob)\n);\n\n// POSITIVE gate: a real meeting has at least one other human OR a video link.\nconst isRealMeeting = (otherAttendeeCount >= 1) || hasVideoLink;\n\nconst startRaw = (ev.start && (ev.start.dateTime || ev.start.date)) || '';\nconst startDate = startRaw ? String(startRaw).slice(0, 10) : '';\nlet startMs = 0;\nif (startRaw) { const d = new Date(startRaw); if (!isNaN(d.getTime())) startMs = d.getTime(); }\nconst dueMs = startMs ? startMs - 24 * 60 * 60 * 1000 : 0;\n\nreturn {\n  json: {\n    gcalId: ev.id || '',\n    gcalLink: ev.htmlLink || '',\n    meetingLink,\n    title: ev.summary || '(no title)',\n    startRaw,\n    startDate,\n    startMs,\n    dueMs,\n    attendeeEmails: allEmails.join(', '),\n    attendeeDomains: attendeeDomains.join(', '),\n    otherAttendeeCount,\n    hasVideoLink,\n    isRealMeeting\n  }\n};"
      },
