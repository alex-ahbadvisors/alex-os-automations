      "parameters": {
        "jsCode": "// One item per non-wiring attachment for upload to the task.\nlet kept = [];\ntry { kept = $('Filter Out Wiring PDF').first().json.keptAttachments || []; } catch (e) { kept = []; }\nconst out = [];\nfor (const a of kept) {\n  const url = a.download_url || a.url || a.TempDownloadUri;\n  if (!url) continue;\n  out.push({ json: { attachmentUrl: url, fileName: a.fileName || a.filename || a.name || 'attachment.pdf' } });\n}\nreturn out;"
      },
