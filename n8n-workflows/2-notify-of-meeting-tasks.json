    {
      "parameters": {
        "jsCode": "/**\n * n8n Code / Function node\n * Input: items[] where each item.json is either a list object or an array of them\n * Output: { accessory: { type: \"static_select\", option_groups: [...] } }\n */\n\nconst ACTION_ID = \"assign_meeting_project\";\nconst PLACEHOLDER = \"Select an item\";\n\nfunction txt(s) {\n  if (s == null) return \"\";\n  return String(s).replace(/\\r?\\n/g, \" · \").trim();\n}\nfunction optionText(listName, folderName) {\n  const ln = txt(listName);\n  const fn = txt(folderName);\n  return fn ? `${ln} (${fn})` : ln;\n}\n\n// Normalize input to a flat array of records\nconst records = [];\nfor (const it of items) {\n  const j = it.json;\n  if (Array.isArray(j)) records.push(...j);\n  else if (j && typeof j === \"object\") records.push(j);\n}\n\n// Group by spaceId (exclude archived)\nconst bySpace = new Map();\nfor (const r of records.filter(r => r.archived !== true)) {\n  const key = String(r.spaceId ?? \"\");\n  if (!bySpace.has(key)) {\n    bySpace.set(key, { label: txt(r.spaceName || \"Untitled Space\"), rows: [] });\n  }\n  bySpace.get(key).rows.push(r);\n}\n\n// Sort rows within each group: folderName then listName\nfor (const { rows } of bySpace.values()) {\n  rows.sort((a, b) =>\n    txt(a.folderName).localeCompare(txt(b.folderName)) ||\n    txt(a.listName).localeCompare(txt(b.listName))\n  );\n}\n\n// Build Slack option_groups\nconst option_groups = Array.from(bySpace.values()).map(group => ({\n  label: { type: \"plain_text\", text: group.label },\n  options: group.rows.map(r => ({\n    text: { type: \"plain_text\", text: optionText(r.listName, r.folderName) },\n    value: String($('Meeting Note').first().json.id + '-'+ r.id) \n  })),\n}));\n\n// Wrap in accessory for a section block\nconst accessory = {\n  action_id: ACTION_ID,\n  type: \"static_select\",\n  placeholder: { type: \"plain_text\", text: PLACEHOLDER },\n  option_groups, \n  confirm: {\n    \"title\": {\n        \"type\": \"plain_text\",\n        \"text\": \"Are you sure?\"\n    },\n    \"text\": {\n        \"type\": \"plain_text\",\n        \"text\": \"I'll add these tasks to the project.\"\n    },\n    \"confirm\": {\n        \"type\": \"plain_text\",\n        \"text\": \"Continue\"\n    },\n    \"deny\": {\n        \"type\": \"plain_text\",\n        \"text\": \"Stop!\"\n    }\n  }\n};\n\n// Output\nreturn [{ json: { accessory } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
