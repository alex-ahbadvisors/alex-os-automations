    {
      "parameters": {
        "jsCode": "// Reverse half of the Supabase <-> ClickUp contact-review loop.\n// Reads the ClickUp task's decision + tier custom fields and maps them to a Supabase\n// update. Returns [] (no-op) for anything not yet decided or off the review list.\nconst REVIEW_LIST = '901113915616';\nconst FIELD_CONTACT_ID = '94a86f21-96bb-4e58-bcbe-cf3511191a8b';\nconst FIELD_TIER = 'c8545afb-8545-4c70-b767-6a8241b30e8e';\nconst FIELD_DECISION = 'cff1e6b4-f015-4353-af6f-8ba32f00d722';\nconst KEEP_ID = 'a52392eb-c34a-4c4f-bff0-9338345d6382';\nconst DELETE_ID = '64561729-6765-4f94-8a8e-94b4c5762aa3';\nconst TIER_IDS = ['63e1a91f-4d4b-4296-a1b3-d229504bbc97','5db6651f-9f16-4daa-9d1b-33226ae546ba','e3898a51-b7f7-4d48-b92e-96014092ff94','2a51dae1-349b-4ead-bc30-8e5a0354669f'];\n\n// The ClickUp node returns the task object; tolerate either $json or $json.body.\nconst t = $json && $json.custom_fields ? $json : ($json.body || $json);\nif (!t || !t.list || t.list.id !== REVIEW_LIST) return [];\n// Ignore our own 'complete' event so closing the task doesn't re-trigger a write.\nconst stType = (t.status && t.status.type) || '';\nif (stType === 'closed' || stType === 'done') return [];\n\nconst cf = {};\n(t.custom_fields || []).forEach(f => { cf[f.id] = f.value; });\nconst contactId = cf[FIELD_CONTACT_ID];\nif (!contactId) return [];\n\nfunction idx(v, ids) {\n  if (v === 0 || (v && /^\\d+$/.test(String(v)))) return Number(v);\n  const i = ids.indexOf(v);\n  return i >= 0 ? i : null;\n}\nlet decision = null;\nconst dv = cf[FIELD_DECISION];\nif (dv === KEEP_ID) decision = 'keep';\nelse if (dv === DELETE_ID) decision = 'delete';\nelse { const i = idx(dv, [KEEP_ID, DELETE_ID]); decision = i === 0 ? 'keep' : (i === 1 ? 'delete' : null); }\nif (!decision) return [];\n\nconst ti = idx(cf[FIELD_TIER], TIER_IDS);\nconst tier = (ti === 0 || ti) ? ti + 1 : null;\n// A Keep isn't actionable until a Tier is also chosen — wait for it (Delete needs no tier).\nif (decision === 'keep' && !tier) return [];\n\nreturn [{ json: { contact_id: contactId, decision, relationship_tier: tier, task_id: t.id } }];"
      },
