    {
      "parameters": {
        "jsCode": "// Filter out the wiring-instructions PDF (correct filename; fixes Relay's .pdfff typo).\nconst WIRING = 'AHB Advisors - Incoming Wiring Instructions.pdf';\nlet atts = [];\ntry { atts = $json.body.Attachments || $json.body.attachments || []; } catch (e) { atts = []; }\nconst kept = atts.filter(a => {\n  const fn = a.fileName || a.filename || a.name || '';\n  return fn.indexOf(WIRING) === -1;\n});\n// Build a comma-joined string of the kept filenames for the task name.\nconst names = kept.map(a => a.fileName || a.filename || a.name || '').join(',');\nreturn [{ json: { keptAttachments: kept, keptNames: names } }];"
      },
      "id": "22222222-0003-4000-8000-000000000003",
      "name": "Filter Out Wiring PDF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -352,
        0
      ],
      "alwaysOutputData": true
    },
