        "folderless": true,
        "list": "901112285837",
        "name": "=[{{ $('Set Invoice Context').item.json.transactionDate }}] - {{ $('Set Invoice Context').item.json.invoiceNumber }} - {{ $json.keptNames }}",
        "additionalFields": {
          "content": "=Invoice for {{ $('Set Invoice Context').item.json.customer }}\nAmount due: {{ $('Set Invoice Context').item.json.balance }}\nDue date: {{ $('Set Invoice Context').item.json.dueDate }}\n[View invoice]({{ $('Set Invoice Context').item.json.invoiceLink }})",
          "markdownContent": true,
          "startDate": "={{ $now }}",
          "customFieldsJson": "=[{\"id\":\"FILL_IN_AMOUNT_DUE_FIELD_ID\",\"value\":{{ $('Set Invoice Context').item.json.balance }}},{\"id\":\"FILL_IN_CLIENT_NAME_FIELD_ID\",\"value\":\"{{ $('Set Invoice Context').item.json.customer }}\"},{\"id\":\"FILL_IN_DUE_DATE_FIELD_ID\",\"value\":\"{{ $('Set Invoice Context').item.json.dueDate }}\"},{\"id\":\"FILL_IN_INVOICE_LINK_FIELD_ID\",\"value\":\"{{ $('Set Invoice Context').item.json.invoiceLink }}\"},{\"id\":\"FILL_IN_INVOICE_NUMBER_FIELD_ID\",\"value\":\"{{ $('Set Invoice Context').item.json.invoiceNumber }}\"},{\"id\":\"FILL_IN_INVOICE_STATUS_FIELD_ID\",\"value\":\"Invoice Sent\"}]"
        }
