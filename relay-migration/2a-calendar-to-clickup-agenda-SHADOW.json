    {
      "parameters": {
        "jsCode": "// FIX for the Relay customCode bug: Relay mapped input key \"email domains\" but\n// the JS read input.emails, so domains were ALWAYS empty on the AHB path.\n// Here we read the ACTUAL Google Calendar attendees array and derive:\n//   - attendeeEmails: comma-separated guest emails\n//   - attendeeDomains: unique comma-separated email domains\n// plus the normalized start date/time + meeting link for downstream nodes.\nconst ev = $input.item.json;\nconst attendees = Array.isArray(ev.attendees) ? ev.attendees : [];\nconst emails = attendees\n  .map(a => (a && a.email ? String(a.email).trim() : ''))\n  .filter(Boolean);\nconst domains = [...new Set(\n  emails\n    .map(e => e.split('@')[1]?.toLowerCase())\n    .filter(Boolean)\n)];\n\nconst startRaw = ev.start?.dateTime || ev.start?.date || '';\nconst startDate = startRaw ? startRaw.slice(0, 10) : '';\n\n// Meeting/video link: prefer hangoutLink, then conferenceData entry points.\nlet meetingLink = ev.hangoutLink || '';\nif (!meetingLink && ev.conferenceData?.entryPoints?.length) {\n  const video = ev.conferenceData.entryPoints.find(p => p.entryPointType === 'video');\n  meetingLink = video?.uri || ev.conferenceData.entryPoints[0]?.uri || '';\n}\n\nreturn {\n  json: {\n    gcalId: ev.id || '',\n    gcalLink: ev.htmlLink || '',\n    meetingLink,\n    title: ev.summary || '(no title)',\n    startRaw,\n    startDate,\n    attendeeEmails: emails.join(', '),\n    attendeeDomains: domains.join(', ')\n  }\n};"
      },
