    {
      "parameters": {
        "jsCode": "// Build one item per attachment across all fetched messages.\nlet msgs = [];\ntry { msgs = $('Missive Get Messages').first().json.messages || []; } catch (e) { msgs = []; }\nconst vendor = (() => { try { return $('Extract Invoice').first().json.output['Vendor Name'] || 'Vendor'; } catch (e) { return 'Vendor'; } })();\nconst today = $now.format('yyyy-MM-dd');\nconst out = [];\nfor (const m of msgs) {\n  const atts = m.attachments || [];\n  for (const a of atts) {\n    if (!a.url && !a.download_url) continue;\n    const fileName = a.filename || a.name || 'attachment';\n    out.push({ json: {\n      attachmentUrl: a.download_url || a.url,\n      driveFileName: '[' + today + '] ' + vendor + ' - ' + fileName + ' - Invoice.pdf'\n    }});\n  }\n}\nreturn out;"
      },
