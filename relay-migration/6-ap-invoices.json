    {
      "parameters": {
        "jsCode": "// Pick the invoice PDF: first PDF-ish attachment across all fetched messages.\n// Always outputs exactly one item so the linear spine never breaks; if no PDF\n// is found, pdfUrl is '' and the downstream download/extract are skipped-safe\n// (they run best-effort and the extractor falls back to the email body).\nlet msgs = [];\ntry { msgs = $('Missive Get Messages').first().json.messages || []; } catch (e) { msgs = []; }\nlet pdfUrl = '';\nlet pdfName = '';\nfor (const m of msgs) {\n  const atts = (m && m.attachments) || [];\n  for (const a of atts) {\n    if (!a) continue;\n    const url = a.download_url || a.url;\n    if (!url) continue;\n    const fn = String(a.filename || a.name || '').toLowerCase();\n    const mt = String(a.media_type || a.content_type || a.mime_type || '').toLowerCase();\n    const isPdf = fn.endsWith('.pdf') || mt.includes('pdf');\n    if (isPdf) { pdfUrl = url; pdfName = a.filename || a.name || 'invoice.pdf'; break; }\n  }\n  if (pdfUrl) break;\n}\nreturn [{ json: { pdfUrl, pdfName, hasPdf: Boolean(pdfUrl) } }];"
      },
